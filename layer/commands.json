{
  "$comment": "Single source of truth for layer→VS Code wiring. The layer prefers the command bridge (official commands with arguments); these chords are the fallback. `tabs` = views, bound to the companion's `handide.tab` with the view name; `actions` = official command IDs.",
  "modifiers": "ctrl+alt+shift",
  "tabs": {
    "editor": "F1",
    "search": "F3",
    "git": "F4",
    "terminal": "F5",
    "ai": "F6",
    "terminalDock": "F2"
  },
  "actions": {
    "quickOpen": {
      "key": "F7",
      "command": "workbench.action.quickOpen"
    },
    "commandPalette": {
      "key": "F8",
      "command": "workbench.action.showCommands"
    },
    "save": {
      "key": "F9",
      "command": "workbench.action.files.save"
    },
    "undo": {
      "key": "F10",
      "command": "undo"
    },
    "redo": {
      "key": "F11",
      "command": "redo"
    },
    "find": {
      "key": "F12",
      "command": "actions.find"
    },
    "toggleMaximizedPanel": {
      "key": "F13",
      "command": "workbench.action.toggleMaximizedPanel"
    }
  }
}
