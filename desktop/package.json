{
	"name": "handide-desktop",
	"publisher": "handide",
	"displayName": "handide",
	"description": "Open this project on your phone with a QR code, and open a project of your other PCs where it lives, in this editor (Remote - SSH over your tailnet).",
	"version": "0.1.0",
	"license": "MIT",
	"engines": {
		"vscode": "^1.80.0"
	},
	"extensionKind": [
		"ui"
	],
	"main": "./extension.js",
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"commands": [
			{
				"command": "handide.openOnPC",
				"title": "Open Project on Another PC",
				"category": "handide"
			},
			{
				"command": "handide.switch",
				"title": "Switch Where This Project Runs",
				"category": "handide"
			},
			{
				"command": "handide.openOnPhone",
				"title": "Open on Phone",
				"category": "handide",
				"icon": "$(device-mobile)"
			}
		],
		"configuration": {
			"title": "handide",
			"properties": {
				"handide.port": {
					"type": "number",
					"default": 9000,
					"description": "The port handide runs on (handide --port). Open on Phone starts handide on it when nothing answers there."
				}
			}
		}
	}
}
