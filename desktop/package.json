{
	"name": "handide",
	"publisher": "yangjongwon",
	"displayName": "handide: VS Code on your phone",
	"description": "Open this project on your phone: press the phone button, scan the QR code, and code from the phone with your own VS Code, extensions and AI agents.",
	"version": "0.2.1",
	"license": "MIT",
	"icon": "icon.png",
	"repository": {
		"type": "git",
		"url": "https://github.com/YangJongWon/handide"
	},
	"homepage": "https://github.com/YangJongWon/handide#readme",
	"bugs": {
		"url": "https://github.com/YangJongWon/handide/issues"
	},
	"categories": [
		"Other"
	],
	"keywords": [
		"mobile",
		"phone",
		"qr",
		"remote",
		"tailscale",
		"claude-code"
	],
	"engines": {
		"vscode": "^1.80.0"
	},
	"extensionKind": [
		"ui"
	],
	"main": "./extension.js",
	"files": [
		"LICENSE",
		"extension.js",
		"runtime.js",
		"icon.png",
		"app/**"
	],
	"activationEvents": [
		"onStartupFinished"
	],
	"contributes": {
		"commands": [
			{
				"command": "handide.openOnPC",
				"title": "Open Project on Another PC",
				"category": "handide"
			},
			{
				"command": "handide.switch",
				"title": "Switch Where This Project Runs",
				"category": "handide"
			},
			{
				"command": "handide.openOnPhone",
				"title": "Open on Phone",
				"category": "handide",
				"icon": "$(device-mobile)"
			},
			{
				"command": "handide.stop",
				"title": "Stop",
				"category": "handide"
			}
		],
		"configuration": {
			"title": "handide",
			"properties": {
				"handide.port": {
					"type": "number",
					"default": 9000,
					"description": "The port handide runs on (handide --port). Open on Phone starts handide on it when nothing answers there."
				}
			}
		}
	}
}
