{
  "name": "handide-mobile",
  "displayName": "handide Mobile",
  "description": "Companion for the handide mobile layer: one full-screen area per tab, layer keybindings, Agent Hub.",
  "publisher": "handide",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "*"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "handide.searchPeers",
        "title": "Search Other PCs",
        "category": "handide"
      },
      {
        "command": "handide.view",
        "title": "Show Mobile View",
        "category": "handide"
      },
      {
        "command": "handide.tab",
        "title": "Show Mobile Tab",
        "category": "handide"
      },
      {
        "command": "handide.state",
        "title": "Mobile State",
        "category": "handide"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "handide-files",
          "title": "Files",
          "icon": "media/files.svg"
        },
        {
          "id": "handide-search",
          "title": "Search",
          "icon": "media/search.svg"
        },
        {
          "id": "handide-git",
          "title": "Git",
          "icon": "media/git.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "handide-ext",
          "title": "Extension",
          "icon": "media/extensions.svg"
        }
      ]
    },
    "views": {
      "handide-files": [
        {
          "id": "handide.files.home",
          "name": "Files",
          "when": "false"
        },
        {
          "id": "handide.peers",
          "name": "Other PCs",
          "when": "handide.hasPeers"
        }
      ],
      "handide-search": [
        {
          "id": "handide.search.home",
          "name": "Search",
          "when": "false"
        }
      ],
      "handide-git": [
        {
          "id": "handide.git.home",
          "name": "Git",
          "when": "false"
        }
      ],
      "handide-ext": [
        {
          "id": "handide.ext.home",
          "name": "Extension",
          "when": "false"
        }
      ]
    },
    "keybindings": []
  }
}
